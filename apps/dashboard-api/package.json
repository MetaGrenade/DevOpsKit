{
  "name": "@fdt/dashboard-api",
  "version": "0.0.1-alpha",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --exclude ../../packages/**/dist/** --exclude ../../apps/cli/dist/** src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fdt/adapters": "workspace:*",
    "@fdt/core": "workspace:*",
    "@fdt/schemas": "workspace:*",
    "@fdt/validators": "workspace:*",
    "fast-glob": "^3.3.3",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
