# Dashboard API environment variables
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (used in later phases with Prisma)
DATABASE_URL=postgresql://fdt:fdt@localhost:5432/fdt

# Redis (used in later phases for jobs/cache)
REDIS_URL=redis://localhost:6379

# Auto-load CLI reports from disk (paths relative to monorepo root, not dashboard-api cwd)
FDT_REPO_ROOT=.
FDT_WORKSPACE_ROOT=resources/sample-workspaces/basic-server
